# Copy to .env and fill values. Do NOT commit real secrets.
# cp .env.example .env

# WeChat mini-program (live login). Leave empty → API uses DEV mode login stub.
WECHAT_APPID=
WECHAT_SECRET=

# Organize engine: auto | hermes | script
# Container / compose default is script (lightweight). Use auto when Hermes+keys available.
ORGANIZE_ENGINE=script

# Hermes subprocess timeout (seconds), typically 180–300
HERMES_TIMEOUT_SEC=240

# Free-tier daily organize limit (Asia/Shanghai calendar day)
FREE_QUOTA_LIMIT=5
# Alias also accepted by server:
# QUOTA_DAILY_LIMIT=5
