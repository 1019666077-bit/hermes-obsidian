.hero .title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero .subtitle {
  color: #4f46e5;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.pitch {
  color: #4b5563;
  margin-bottom: 28rpx;
  font-size: 28rpx;
}

.steps {
  margin-bottom: 36rpx;
}

.step {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  color: #374151;
  border-bottom: 1rpx solid #f0f0f3;
}

.step:last-child {
  border-bottom: none;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: 16rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #4f46e5;
  background: #eef2ff;
  border-radius: 50%;
  flex-shrink: 0;
}

.btn-upgrade {
  margin-top: 24rpx;
}
