.page {
  padding-bottom: 48rpx;
}

.hero .title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero .subtitle {
  color: #4f46e5;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.pitch {
  color: #4b5563;
  margin-bottom: 28rpx;
}

.steps {
  margin-bottom: 36rpx;
}

.step {
  padding: 12rpx 0;
  color: #374151;
  border-bottom: 1rpx solid #eee;
}

.hint {
  text-align: center;
  color: #9ca3af;
  font-size: 22rpx;
  padding: 0 32rpx;
}
