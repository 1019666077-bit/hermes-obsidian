<view class="page">
  <view class="card quota-card {{exhausted ? 'is-exhausted' : ''}}">
    <view class="quota-head">
      <text class="quota-plan">{{planLabel}}</text>
      <text class="quota-remain">{{quotaRemainLabel}}</text>
    </view>
    <view class="quota-bar">
      <view class="quota-bar-fill" style="width: {{quotaPercent}}%;"></view>
    </view>
    <view class="quota-hint">{{quotaHint}}</view>
    <view wx:if="{{loginLabel}}" class="login-chip">{{loginLabel}}</view>
    <button wx:if="{{exhausted}}" class="btn-primary btn-upgrade" bindtap="onUpgrade">开通会员</button>
  </view>

  <view class="card">
    <view class="section-title">选择笔记</view>
    <view class="desc">推荐上传包含笔记的 .zip；也可从聊天记录选 md / txt。</view>

    <view wx:if="{{!filePath}}" class="empty">
      <view class="empty-title">还没选择文件</view>
      <view class="empty-desc">从微信聊天记录里选一个 zip、md 或 txt</view>
    </view>
    <view wx:else class="file-chip">已选：{{fileName}}</view>

    <button
      class="{{filePath ? 'btn-secondary' : 'btn-primary'}}"
      bindtap="chooseFile"
      disabled="{{busy}}"
    >{{filePath ? '重新选择' : '选择 zip / 文件'}}</button>
  </view>

  <view class="card" wx:if="{{filePath}}">
    <button
      class="btn-primary"
      bindtap="startOrganize"
      disabled="{{busy || exhausted}}"
    >{{busy ? '整理中…' : (exhausted ? '今日次数已用完' : '开始整理')}}</button>
    <view wx:if="{{busy}}" class="progress-hint">请稍候，整理时请勿离开本页</view>
    <view wx:elif="{{exhausted}}" class="progress-hint">免费次数用完后可开通会员，或明天再试</view>
  </view>

  <view class="card" wx:if="{{status}}">
    <view class="section-title">状态</view>
    <view class="status {{statusKind}}">{{status}}</view>
    <view wx:if="{{engine}}" class="engine">引擎：{{engine}}</view>
    <view wx:if="{{jobId}}" class="job">任务 {{jobId}}</view>
  </view>

  <view class="card" wx:if="{{downloadPath}}">
    <view class="section-title">结果</view>
    <view class="desc">vault zip 已就绪，可打开预览或保存到本机。</view>
    <button class="btn-primary" bindtap="openVault">打开 / 预览 zip</button>
    <button class="btn-secondary btn-save" bindtap="saveVault">保存到本地</button>
  </view>
</view>
